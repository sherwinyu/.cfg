# This repository uses /Users/sherwin as its work tree. Keep patterns rooted
# so an ignored home directory name does not hide matching project content.

# Home directories and large workspaces
/.cfg/
/Applications/
/Claude/
/Desktop/
/Documents/
/Downloads/
/Dropbox
/Library/
/Movies/
/Music/
/Pictures/
/Public/
/Sites/
/projects/
/conductor/
/explain-diffs/
/oryoki-archive/
/qmk_firmware/
/visualizations/
/cfg/google-cloud-sdk/
/cfg/vim/plugged/

# Credentials and private account state
/.ashby_api_key
/.aws/
/.emulator_console_auth_token
/.netrc
/.npmrc
/.ssh/
/.config/1Password/
/.config/gcloud/
/.config/gh/
/.config/raycast/
/.config/vercel-plugin/
/.docker/
/.fly/
/.supabase/

# Codex and Claude app-managed runtime state. Portable source lives under
# cfg/Codex and cfg/claude; only explicitly curated files are tracked here.
/.codex/*
!/.codex/AGENTS.md
!/.codex/*.config.toml
/.claude/*
!/.claude/settings.json
/cfg/claude/plugins/*
!/cfg/claude/plugins/config.json

# Generated application state
/.config/cagent/
/.config/coc/
/.config/devin/
/.config/github-copilot/
/.config/graphite/
/.config/iterm2/
/.config/karabiner/automatic_backups/
/.config/karabiner/karabiner.json
/.config/nvim/autoload/
/.config/qBittorrent/

# Toolchains, package managers, caches, and local application data
/.android/
/.bun/
/.bundle/
/.cache/
/.cargo/
